BUNNY_LIBRARY_ID=123
# Create or retrieve this read-only Stream API key from the configured Bunny library settings.
BUNNY_STREAM_API_KEY=REPLACE_WITH_BUNNY_READ_ONLY_KEY
BUNNY_CDN_HOSTNAME=REPLACE_WITH_BUNNY_CDN_HOSTNAME
# Optional: leave empty if CDN token authentication is disabled.
BUNNY_TOKEN_AUTH_KEY=
# OpenAI API billing/credits are separate from a ChatGPT subscription.
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
# Optional but recommended: activates one global, faster transcription job.
ASSEMBLYAI_API_KEY=
# "eu" uses the European API endpoint; "global" uses the global endpoint.
ASSEMBLYAI_REGION=eu
# Login username is fixed to team; set only a long random password here.
APP_PASSWORD=REPLACE_WITH_LONG_RANDOM_TEAM_PASSWORD
# SQLite path for textual reports and job metadata. Railway production uses /data/bunny-video-report.sqlite3.
DATABASE_PATH=bunny-video-report.sqlite3
# Inventory reads use the public CSV export; override only for another spreadsheet.
GOOGLE_SHEET_ID=1yw2K-1cH5goQER1tP3KItvluXMv7N_H5RoratcWZoZo
# Optional JSON on one line. Required only to write a confirmed Bunny link back to the Sheet.
# Share the spreadsheet with the service-account email as Editor before enabling it.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Conservative proposal settings; every match still requires human confirmation.
INVENTORY_MATCH_THRESHOLD=0.88
INVENTORY_MATCH_MARGIN=0.08
MEDIA_RUNTIME_SECONDS=21600
MEDIA_INACTIVITY_SECONDS=120
MEDIA_MAX_WORKSPACE_BYTES=2000000000
# Replace with your own authorized sample; used only by the opt-in live test.
BUNNY_SAMPLE_VIDEO_URL=https://iframe.mediadelivery.net/embed/123/00000000-0000-0000-0000-000000000001
# Explicitly enable only when running the paid live test.
RUN_LIVE_BUNNY=0
